# ==========================================================================
# NetScaler Dashboard — environment template. Copy to .env and edit.
# ==========================================================================

# --- Web app ---------------------------------------------------------------
# The dashboard serves HTTPS on 443 with a self-signed cert by default.
APP_HOST=0.0.0.0
APP_PORT=443
APP_SSL=1
# APP_SECRET is auto-generated & persisted to .app_secret if left blank.
APP_SECRET=

# On first boot a local CA is generated and used to sign the server cert.
# Install the CA (Settings → Download CA Certificate) for warning-free HTTPS,
# or upload your own cert / sign a generated CSR.
# The files live in the data directory (DATA_DIR/certs/) unless you point these elsewhere.
#TLS_CERT_FILE=
#TLS_KEY_FILE=
#TLS_CA_CERT_FILE=
#TLS_CA_KEY_FILE=
# The built-in certificate names this host and its addresses by itself (TLS_SAN_AUTO=0 turns that off).
# Extra Subject Alternative Names for the server cert (comma-separated hostnames/IPs).
TLS_SAN=
# TLS_COMMON_NAME=netscaler-dashboard

# Send HSTS on HTTPS responses (disable if you terminate TLS elsewhere without HTTPS).
HSTS_ENABLED=1

# Set to 1 only when running behind a trusted reverse proxy (honors X-Forwarded-*).
TRUST_PROXY=0

# --- Storage / retention --------------------------------------------------
# All runtime state (config, LDAP, DB, certs, secret) lives under DATA_DIR — back
# it with a Docker named volume (compose does this) so updates never wipe it.
DATA_DIR=data
# Local SQLite history DB (failover events + session history). Defaults to DATA_DIR/dashboard.db.
DASHBOARD_DB_FILE=
# Keep at least this many days of history; older rows are deleted automatically.
RETENTION_DAYS=7
# How often the retention pass runs (seconds).
RETENTION_INTERVAL_SECS=3600
# A stored session counts as "Active" if seen within this many seconds.
SESSION_ACTIVE_WINDOW_SECS=120

# Legacy JSON failover file caps at this many events (prunes to 50% at 80% full).
FAILOVER_MAX_EVENTS=5000
# Rotating app log size cap and number of backups.
APP_LOG_MAX_BYTES=5242880
APP_LOG_BACKUPS=3

# --- Gunicorn (always one worker; more threads = more concurrent requests) ---
GUNICORN_THREADS=8

# --- Sign-in throttling: wrong attempts per address before it has to wait ----
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECS=300

# --- Talking to appliances ---------------------------------------------------
# Largest response accepted from a NetScaler (MB), and how long a node that did
# not answer is left alone before the next try (seconds).
NITRO_MAX_BODY_MB=32
NODE_BACKOFF_SECS=10

# --- docker compose: publish the dashboard on another host port --------------
#HOST_PORT=8443

# --- Dashboard login backends ---------------------------------------------
# Comma-separated: local,ldap
AUTH_BACKENDS=local

# --- LDAP / Active Directory ----------------------------------------------
# These are DEFAULTS only. LDAP is also configurable live in Settings → LDAP,
# which persists to ldap_config.json (gitignored) and overrides these values.
LDAP_ENABLED=0
LDAP_SERVER=
LDAP_PORT=389
LDAP_USE_SSL=0
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_ATTRIBUTE=sAMAccountName
LDAP_ALLOWED_GROUP_DN=
LDAP_TIMEOUT_SECS=10

# --- NITRO (NetScaler config API) -----------------------------------------
# Off by default: appliances ship self-signed management certs. HTTPS calls also
# lower the OpenSSL security level so legacy appliance ciphers (AES256-SHA) work.
NITRO_VERIFY_SSL=0
NITRO_TIMEOUT_SECS=15
# Connect timeout (seconds) so an unreachable node fails fast, not after the full read timeout.
NITRO_CONNECT_TIMEOUT_SECS=3

# --- Next-Gen API (NetScaler 14.1+) ---------------------------------------
# Management path of the Next-Gen API. Override if your build exposes it
# elsewhere — GET /api/nextgen-debug probes the candidates and shows what answers.
NEXTGEN_BASE_PATH=/mgmt/api/nextgen/v1
# How often each node's API capability is re-checked, so enabling the Next-Gen API
# (or a node that was unreachable at boot) is picked up without a restart. 0 = off.
API_DETECT_INTERVAL_SECS=600
NEXTGEN_VERIFY_SSL=0
NEXTGEN_TIMEOUT_SECS=15
NS_PORT_HTTPS=443

# --- External database (optional; normally set in Settings -> Database) ---
# Setting DATABASE_URL here makes the Settings section read-only.
#   postgresql://user:password@host:5432/dbname
#   mysql://user:password@host:3306/dbname        (also MariaDB)
#   mssql://user:password@host:1433/dbname
DATABASE_URL=
# off | on (encrypt, do not check the certificate) | verify (encrypt and verify)
DATABASE_TLS=off
