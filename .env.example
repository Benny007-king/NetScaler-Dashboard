# ==========================================================================
# NetScaler Dashboard — environment template. Copy to .env and edit.
# ==========================================================================

# --- Web app ---------------------------------------------------------------
# The dashboard serves HTTPS on 443 with a self-signed cert by default.
APP_HOST=0.0.0.0
APP_PORT=443
APP_SSL=1
# APP_SECRET is auto-generated & persisted to .app_secret if left blank.
APP_SECRET=

# Paths to the TLS cert/key. If missing, a self-signed pair is generated here.
# Replace these files (or upload a new pair from Settings) to use your own cert.
TLS_CERT_FILE=certs/server.crt
TLS_KEY_FILE=certs/server.key

# --- Dashboard login backends ---------------------------------------------
# Comma-separated: local,ldap
AUTH_BACKENDS=local

# --- LDAP / Active Directory ----------------------------------------------
LDAP_ENABLED=0
LDAP_SERVER=
LDAP_PORT=389
LDAP_USE_SSL=0
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_ATTRIBUTE=sAMAccountName
LDAP_ALLOWED_GROUP_DN=
LDAP_TIMEOUT_SECS=10

# --- NITRO (NetScaler config API) -----------------------------------------
NITRO_VERIFY_SSL=0
NITRO_TIMEOUT_SECS=15

# --- Next-Gen API (NetScaler 14.1+) ---------------------------------------
NEXTGEN_VERIFY_SSL=0
NEXTGEN_TIMEOUT_SECS=15
NS_PORT_HTTPS=443
