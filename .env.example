# ==========================================================================
# NetScaler Dashboard — environment template. Copy to .env and edit.
# ==========================================================================

# --- Web app ---------------------------------------------------------------
# The dashboard serves HTTPS on 443 with a self-signed cert by default.
APP_HOST=0.0.0.0
APP_PORT=443
APP_SSL=1
# APP_SECRET is auto-generated & persisted to .app_secret if left blank.
APP_SECRET=

# On first boot a local CA is generated and used to sign the server cert.
# Install the CA (Settings → Download CA Certificate) for warning-free HTTPS,
# or upload your own cert / sign a generated CSR.
TLS_CERT_FILE=certs/server.crt
TLS_KEY_FILE=certs/server.key
TLS_CA_CERT_FILE=certs/ca.crt
TLS_CA_KEY_FILE=certs/ca.key
# Extra Subject Alternative Names for the server cert (comma-separated hostnames/IPs).
TLS_SAN=
# TLS_COMMON_NAME=netscaler-dashboard

# Send HSTS on HTTPS responses (disable if you terminate TLS elsewhere without HTTPS).
HSTS_ENABLED=1

# Set to 1 only when running behind a trusted reverse proxy (honors X-Forwarded-*).
TRUST_PROXY=0

# --- Dashboard login backends ---------------------------------------------
# Comma-separated: local,ldap
AUTH_BACKENDS=local

# --- LDAP / Active Directory ----------------------------------------------
# These are DEFAULTS only. LDAP is also configurable live in Settings → LDAP,
# which persists to ldap_config.json (gitignored) and overrides these values.
LDAP_ENABLED=0
LDAP_SERVER=
LDAP_PORT=389
LDAP_USE_SSL=0
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_ATTRIBUTE=sAMAccountName
LDAP_ALLOWED_GROUP_DN=
LDAP_TIMEOUT_SECS=10

# --- NITRO (NetScaler config API) -----------------------------------------
NITRO_VERIFY_SSL=0
NITRO_TIMEOUT_SECS=15
# Connect timeout (seconds) so an unreachable node fails fast, not after the full read timeout.
NITRO_CONNECT_TIMEOUT_SECS=3

# --- Next-Gen API (NetScaler 14.1+) ---------------------------------------
NEXTGEN_VERIFY_SSL=0
NEXTGEN_TIMEOUT_SECS=15
NS_PORT_HTTPS=443
