# Git
.git
.gitignore
.dockerignore

# Python
__pycache__/
*.pyc
*.pyo
venv/
env/

# Environment variables
.env
.env.local

# Logs
*.log

# App Data & State files
# (We ignore them here so they aren't baked into the image,
# they live in the DATA_DIR named volume)
data/
auth_config.json
nodes_config.json
ldap_config.json
failover_history.json
ha_last_state.json
dashboard.db
dashboard.db-wal
dashboard.db-shm
.app_secret
certs/

# IDE
.vscode/
.idea/

# Release tooling and artefacts - not part of the container image
appliance/
dist/
.github/
*.ova
*.nsu
# ...wherever they are: a second checkout or worktree inside this folder (with its
# own dist/) would otherwise be copied into the image, artefacts and all.
.claude/
**/dist/
**/*.ova
**/*.nsu

# Tests run from a checkout, not from the image
tests/
