#!/bin/sh
# Keeps the address line on the console login screen current.
#
# agetty's own \4 escape is not used: when no interface has an address it falls
# back to the hostname's address and prints https://127.0.1.1/, which reads like
# a working URL. This writes the line itself and says so when there is none.
OUT=/etc/issue.d/10-ns-address.issue

render() {
  addrs=$(ip -4 -o addr show scope global up 2>/dev/null | awk '{sub(/\/.*/, "", $4); print $4}')
  mkdir -p "$(dirname "$OUT")"
  {
    if [ -n "$addrs" ]; then
      for a in $addrs; do echo "  Web interface :  https://$a/"; done
    else
      echo "  Web interface :  no network address yet -"
      echo "                   log in and choose \"Configure network\""
    fi
    echo "  Console login :  nsadmin"
    echo
  } > "$OUT.tmp"
  mv -f "$OUT.tmp" "$OUT"
  agetty --reload 2>/dev/null || true      # redraw login screens nobody is typing at
}

render
ip -4 monitor address 2>/dev/null | while read -r _; do render; done
